{
  "name": "mythrix-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mythrix AI-DM backend — Cloudflare Worker + D1",
  "scripts": {
    "seed:build": "node scripts/seed.mjs",
    "db:schema": "wrangler d1 execute mythrix --local --file=db/schema.sql",
    "db:schema:remote": "wrangler d1 execute mythrix --remote --file=db/schema.sql",
    "db:seed": "wrangler d1 execute mythrix --local --file=db/seed.sql",
    "db:seed:remote": "wrangler d1 execute mythrix --remote --file=db/seed.sql",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240000.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.0.0"
  }
}
