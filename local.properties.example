# Copy this file to local.properties and fill in.
# local.properties is git-ignored — secrets stay on your machine.

# Android SDK location (required for builds)
sdk.dir=/Users/yourname/Library/Android/sdk

# OPTIONAL: HuggingFace access token.
# Default Qwen 2.5 models are PUBLIC — no token needed, end users just press Download.
# Set this only if you switch ModelDownloader URLs to license-gated models (e.g. Gemma).
# Get a token: https://huggingface.co/settings/tokens (type: Read)
hf.token=
