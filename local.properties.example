# Copy this file to local.properties and fill in.
# local.properties is git-ignored — secrets stay on your machine.

# Android SDK location (required for builds)
sdk.dir=/Users/yourname/Library/Android/sdk

# HuggingFace access token for downloading license-gated models (Gemma).
# Steps:
#   1. Go to https://huggingface.co/settings/tokens and create a "Read" token.
#   2. Visit https://huggingface.co/litert-community/Gemma3-1B-IT
#      and accept the Google Gemma license once.
#   3. Paste the token here. Format: hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# After this, end users of the app just press "Download" — license/auth is handled
# transparently via the bundled token.
hf.token=
